# Existing process values take priority over .env.
TELEGRAM_BOT_TOKEN=
# Existing hosts may keep BOT_TOKEN instead of TELEGRAM_BOT_TOKEN.
BOT_TOKEN=
# ALL bot access is restricted to these Telegram IDs. Empty/invalid means nobody.
ADMIN_IDS=
# Optional alternative to encrypted key entry in the admin's private bot chat.
# Values must come from official authorized access; variable names are our settings.
PORTALS_API_KEY=
TONNEL_API_KEY=
MRKT_API_KEY=
# Optional Fernet master key from hosting secrets. Otherwise a private file is
# generated next to the database. Persist/backup that file together with the DB.
GIFT_RADAR_ENCRYPTION_KEY=
# Persistent host directory; new database is radar.sqlite3, never shop.db.
DATA_DIR=data
GIFT_RADAR_DB=data/radar.sqlite3
GIFT_RADAR_SCAN_SECONDS=300
GIFT_RADAR_RETENTION_DAYS=90
GIFT_RADAR_LOG_DIR=logs
