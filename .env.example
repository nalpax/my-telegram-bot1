# Existing process values take priority over .env.
TELEGRAM_BOT_TOKEN=
# Existing hosts may keep BOT_TOKEN instead of TELEGRAM_BOT_TOKEN.
BOT_TOKEN=
# Persistent host directory; new database is radar.sqlite3, never shop.db.
DATA_DIR=data
GIFT_RADAR_DB=data/radar.sqlite3
GIFT_RADAR_SCAN_SECONDS=300
GIFT_RADAR_RETENTION_DAYS=90
GIFT_RADAR_LOG_DIR=logs
