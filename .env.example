# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram ID администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=123456789

# Платежи. Пока токен пустой и CURRENCY не XTR — оплата выключена,
# покупатели видят «оплата скоро будет доступна», каталог и цены работают.
# Для Telegram Stars: оставьте токен пустым и укажите CURRENCY=XTR
PAYMENT_PROVIDER_TOKEN=
CURRENCY=RUB

# База данных. Пусто = SQLite-файл в DATA_DIR.
# Для docker-compose URL на Postgres собирается автоматически.
DATABASE_URL=
DATA_DIR=./data

# Postgres (только для docker-compose)
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop

# Прочее
LOG_LEVEL=INFO
NOTIFY_ADMINS_ON_SALE=true
BROADCAST_DELAY_SECONDS=0.05
